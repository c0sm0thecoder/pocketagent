# From @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user ids allowed to use the bot.
# Message @userinfobot to get yours. The bot refuses to start without this.
ALLOWED_USER_IDS=

# Where Claude starts working (change per chat with /cwd)
DEFAULT_CWD=~/projects

# Optional: opus, sonnet, haiku or a full model id. Empty = your Claude Code default.
CLAUDE_MODEL=

# Tools that never need a Telegram approval. Everything else gets Allow/Deny buttons.
AUTO_ALLOW_TOOLS=Read,Glob,Grep,TodoWrite,mcp__tg__send_file
APPROVAL_TIMEOUT=10m

# Voice: whisper.cpp (brew install whisper-cpp) + a ggml model
WHISPER_MODEL=~/.claude-telegram/models/ggml-small.bin
WHISPER_LANG=auto
