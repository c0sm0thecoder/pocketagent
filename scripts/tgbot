#!/usr/bin/env bash
# tgbot: run the Claude Code Telegram bot in a background tmux session.
set -euo pipefail

PROJECT="$HOME/projects/claude-telegram"
SESSION="tg"
LOG="$HOME/.claude-telegram/bot.log"

running() { tmux has-session -t "$SESSION" 2>/dev/null; }

start() {
  if running; then
    echo "already running (tgbot logs / tgbot stop)"
    return
  fi
  cd "$PROJECT"
  echo "building..."
  go build -o claude-telegram .
  mkdir -p "$(dirname "$LOG")"
  tmux new-session -d -s "$SESSION" -c "$PROJECT" "./claude-telegram 2>&1 | tee -a '$LOG'"
  sleep 2
  if running; then
    echo "started"
    tail -n 2 "$LOG"
  else
    echo "failed to start, last log lines:"
    tail -n 10 "$LOG"
    exit 1
  fi
}

stop() {
  if ! running; then
    echo "not running"
    return
  fi
  # Ctrl-C first so the bot and any claude runs it started exit cleanly.
  tmux send-keys -t "$SESSION" C-c
  for _ in 1 2 3 4 5; do
    running || { echo "stopped"; return; }
    sleep 1
  done
  tmux kill-session -t "$SESSION"
  echo "stopped (forced)"
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; start ;;
  status)  if running; then echo "running"; tail -n 3 "$LOG"; else echo "not running"; fi ;;
  logs)    tail -n 50 -f "$LOG" ;;
  attach)  tmux attach -t "$SESSION" ;;
  *)
    echo "usage: tgbot {start|stop|restart|status|logs|attach}"
    exit 1
    ;;
esac
